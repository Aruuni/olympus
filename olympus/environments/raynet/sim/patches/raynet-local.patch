@@ -1,7 +1,12 @@
-# ! SET YOUR ENVIRONMENT VARIABLES HERE ! #
-export RAYNET_PATH=$HOME/raynet
-export OMNET_PATH=$HOME/omnetpp
-export INET_PATH=$OMNET_PATH/samples/inet4.5
+# Paths are derived automatically from this file's location.
+# RayNet and OMNeT++ are vendored as sibling git submodules under sim/:
+#   sim/raynet   <- this file lives here (RAYNET_PATH)
+#   sim/omnetpp  <- OMNET_PATH
+#   sim/inet4.5  <- symlinked into $OMNET_PATH/samples/inet4.5
+# So the stack builds/runs wherever the Olympus repo is checked out.
+_RAYNET_SELF="${BASH_SOURCE[0]:-$0}"
+export RAYNET_PATH="$(cd "$(dirname "$_RAYNET_SELF")" && pwd)"
+export OMNET_PATH="$(cd "$RAYNET_PATH/.." && pwd)/omnetpp"
+export INET_PATH="$OMNET_PATH/samples/inet4.5"
 
-export RAYNET_VENV_PATH=$RAYNET_PATH/.venv
-# ! BUILD WILL FAIL IF THESE ARE INCORRECT ! #
\ No newline at end of file
+export RAYNET_VENV_PATH="$RAYNET_PATH/.venv"
